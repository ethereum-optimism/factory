{
  "version": 2,
  "registry": "registry.invalid/selftest",
  "shared_paths": [
    ".github/workflows/build-images.yaml",
    "actions/**"
  ],
  "images": {
    "selftest-docker": {
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile"
        }
      },
      "paths": [
        "test/fixtures/docker/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-apko": {
      "builders": {
        "apko": {
          "config": "test/fixtures/apko/tiny.yaml"
        }
      },
      "paths": [
        "test/fixtures/apko/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-dual": {
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile",
          "archs": [
            "amd64"
          ]
        },
        "apko": {
          "config": "test/fixtures/apko/tiny.yaml"
        }
      },
      "primary": "docker",
      "paths": [
        "test/fixtures/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-pkg": {
      "builders": {
        "apko": {
          "config": "test/fixtures/apko/pkg.yaml",
          "needs_packages": [
            "selftest-tool"
          ]
        }
      },
      "paths": [
        "test/fixtures/melange/**",
        "test/fixtures/apko/**"
      ],
      "smoke": {
        "commands": [],
        "script": "test/fixtures/smoke/check-selftest-tool.sh"
      }
    }
  },
  "packages": {
    "selftest-tool": {
      "config": "test/fixtures/melange/selftest-tool.yaml",
      "archs": [
        "x86_64"
      ]
    }
  }
}
