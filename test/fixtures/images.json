{
  "version": 2,
  "registry": "registry.invalid/selftest",
  "apk_registry": {
    "host": "packages.wolfi.dev",
    "path_prefix": "/os/"
  },
  "shared_paths": [
    ".github/workflows/build-images.yaml",
    "actions/**"
  ],
  "images": {
    "selftest-docker": {
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile"
        }
      },
      "paths": [
        "test/fixtures/docker/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ],
        "tests": [
          {
            "shell": "echo smoke-ok",
            "expected_output": "smoke-ok"
          },
          {
            "shell": "exit 3",
            "expected_exit": 3
          },
          {
            "entrypoint": "/bin/echo",
            "args": [
              "two words",
              "second"
            ],
            "expected_output": "two words second"
          }
        ]
      }
    },
    "selftest-bake": {
      "builders": {
        "docker": {
          "mode": "bake",
          "bake_file": "test/fixtures/bake/docker-bake.hcl",
          "target": "selftest-bake"
        }
      },
      "paths": [
        "test/fixtures/bake/**",
        "test/fixtures/docker/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-apko": {
      "builders": {
        "apko": {
          "config": "test/fixtures/apko/tiny.yaml",
          "lockfile": "test/fixtures/apko/tiny.lock.json"
        }
      },
      "paths": [
        "test/fixtures/apko/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-dual": {
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile",
          "archs": [
            "amd64"
          ]
        },
        "apko": {
          "config": "test/fixtures/apko/tiny.yaml",
          "lockfile": "test/fixtures/apko/tiny.lock.json"
        }
      },
      "primary": "docker",
      "paths": [
        "test/fixtures/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-ko": {
      "builders": {
        "docker": {
          "mode": "ko",
          "context": "test/fixtures/ko",
          "importpath": "."
        }
      },
      "paths": [
        "test/fixtures/ko/**"
      ],
      "smoke": {
        "commands": [
          "/ko-app/selftest-ko"
        ]
      }
    },
    "selftest-pkg": {
      "builders": {
        "apko": {
          "config": "test/fixtures/apko/pkg.yaml",
          "needs_packages": [
            "selftest-tool",
            "selftest-gotool"
          ],
          "lockfile": "test/fixtures/apko/pkg.lock.json"
        }
      },
      "paths": [
        "test/fixtures/melange/**",
        "test/fixtures/apko/**"
      ],
      "smoke": {
        "commands": [],
        "script": "test/fixtures/smoke/check-selftest-tool.sh"
      }
    },
    "selftest-versioned-v1": {
      "repository": "selftest-versioned",
      "version": "v1",
      "tag_template": "{version}-{date}-{sha12}",
      "ref_tag_template": "{version}",
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile",
          "archs": [
            "amd64"
          ]
        }
      },
      "paths": [
        "test/fixtures/docker/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    },
    "selftest-versioned-v2": {
      "repository": "selftest-versioned",
      "version": "v2",
      "tag_template": "{version}-{date}-{sha12}",
      "ref_tag_template": "{version}",
      "builders": {
        "docker": {
          "context": "test/fixtures/docker",
          "dockerfile": "Dockerfile",
          "archs": [
            "amd64"
          ]
        }
      },
      "paths": [
        "test/fixtures/docker/**"
      ],
      "smoke": {
        "commands": [
          "/bin/sh -c true"
        ]
      }
    }
  },
  "packages": {
    "selftest-tool": {
      "config": "test/fixtures/melange/selftest-tool.yaml",
      "archs": [
        "x86_64"
      ],
      "env_lockfile": "test/fixtures/melange/selftest-tool.lock.json"
    },
    "selftest-gotool": {
      "config": "test/fixtures/melange/selftest-gotool.yaml",
      "archs": [
        "x86_64"
      ]
    }
  }
}
